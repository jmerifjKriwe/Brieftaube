# Brieftaube configuration (copy to .env — never commit the real .env).
# All variables use the BRIEFTAUBE_ prefix. See src/brieftaube/config.py.

# --- Core -------------------------------------------------------------------

# Secret used for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIEFTAUBE_SECRET_KEY=change-me

# SQLite database file (WAL mode is enabled by the app).
BRIEFTAUBE_DATABASE_PATH=data/brieftaube.db

# Default UI language when no preference is sent: en | de
BRIEFTAUBE_DEFAULT_LOCALE=en

# --- Integrations -----------------------------------------------------------

# signal-cli-rest-api sidecar (see compose.yaml).
BRIEFTAUBE_SIGNAL_CLI_URL=http://signal-cli:8080

# MQTT broker for context variables (leave empty to disable the consumer).
BRIEFTAUBE_MQTT_HOST=
BRIEFTAUBE_MQTT_PORT=1883
BRIEFTAUBE_MQTT_USERNAME=
BRIEFTAUBE_MQTT_PASSWORD=
